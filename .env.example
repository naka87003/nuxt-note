# Copy the connection strings from Supabase Dashboard > Connect.
# Replace the placeholders below with your project's connection details.
# Runtime connection: Supabase Transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:6543/postgres"
# Prisma CLI / migrations: Supabase Session pooler (port 5432).
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:5432/postgres"

# Set this before starting dev to ensure session cookies can be sealed.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NUXT_APP_SECRET=""
NUXT_OAUTH_GITHUB_CLIENT_ID=""
NUXT_OAUTH_GITHUB_CLIENT_SECRET=""

# Server-only OpenAI connection (may share the nuxt-chat key).
NUXT_OPENAI_API_KEY=""
NUXT_OPENAI_MODEL="gpt-6.1-sol"
