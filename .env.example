# Runtime connection. Local PostgreSQL works without Supabase.
DATABASE_URL="postgresql://nuxt_note:nuxt_note@localhost:5432/nuxt_note"
# Prisma CLI: direct connection, or Supabase Session pooler (5432).
# May equal DATABASE_URL during local development.
DIRECT_URL="postgresql://nuxt_note:nuxt_note@localhost:5432/nuxt_note"

# Set this before starting dev to ensure session cookies can be sealed.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NUXT_APP_SECRET=""
NUXT_OAUTH_GITHUB_CLIENT_ID=""
NUXT_OAUTH_GITHUB_CLIENT_SECRET=""

# Server-only OpenAI connection (may share the nuxt-chat key).
NUXT_OPENAI_API_KEY=""
NUXT_OPENAI_MODEL="gpt-6.1-sol"
