{
  "name": "nuxt-note",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.11.1 <27"
  },
  "scripts": {
    "dev": "nuxt dev --port 3001 --host localhost",
    "build": "prisma generate && nuxt build",
    "preview": "nuxt preview --port 3001",
    "postinstall": "nuxt prepare && prisma generate",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:db": "node scripts/test-database.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:chat": "node scripts/test-chat.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.108",
    "@fontsource-variable/inter": "^5.2.0",
    "@nuxt/ui": "^4.12.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "ai": "^7.0.162",
    "dotenv": "^18.0.9",
    "markdown-it": "^15.0.3",
    "nuxt": "^4.6.4",
    "nuxt-auth-utils": "^0.6.0",
    "pg": "^8.23.1",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.151",
    "@nuxt/eslint": "^1.17.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
