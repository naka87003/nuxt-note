{
  "name": "nuxt-note",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.11.1 <27"
  },
  "scripts": {
    "check:mcp:remote": "node scripts/check-mcp-remote.mjs",
    "test:agent": "node scripts/test-agent-access.mjs",
    "storybook": "storybook dev --port 6006 --host localhost --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "typecheck:storybook": "nuxt prepare && vue-tsc --noEmit -p .storybook/tsconfig.json",
    "chromatic": "chromatic",
    "dev": "nuxt dev --port 3001 --host localhost",
    "build": "prisma generate && nuxt build",
    "preview": "nuxt preview --port 3001",
    "postinstall": "nuxt prepare && prisma generate",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:db": "node scripts/test-database.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:chat": "node scripts/test-chat.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.108",
    "@comark/nuxt": "^0.9.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@nuxt/ui": "^4.12.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vueuse/core": "^15.0.0",
    "ai": "^7.0.162",
    "dotenv": "^18.0.9",
    "htmlparser2": "^12.0.0",
    "nuxt": "^4.6.4",
    "nuxt-auth-utils": "^0.6.0",
    "pg": "^8.23.1",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.4",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.151",
    "@modelcontextprotocol/client": "^2.4.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/storybook": "10.0.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vue/test-utils": "^2.5.1",
    "chromatic": "^18.14.2",
    "eslint": "^10.14.0",
    "eslint-plugin-storybook": "^10.6.6",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "storybook": "^10.6.6",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
